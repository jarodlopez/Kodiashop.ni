{
  "buildCommand": "node configure.js",
  "outputDirectory": ".",
  "installCommand": "echo skip",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/como-comprar",
      "destination": "/como-comprar.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/producto/:id",
      "destination": "/api/producto?id=:id"
    }
  ],
  "functions": {
    "api/producto.js": {
      "includeFiles": "index.html"
    }
  }
}
